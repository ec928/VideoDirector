<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the app's TFM to reference it. The tests themselves are plain .NET: they
         exercise logic that is deliberately free of WinUI types, so no UI thread is needed. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>annotations</Nullable>
    <IsPackable>false</IsPackable>
    <UseWinUI>false</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <!-- Reference copies of the previous release, kept here to diff behaviour against. They are a
       whole second copy of the app, so the default glob compiles them into the test assembly and
       every type collides with the real one. They are data, not sources. -->
  <ItemGroup>
    <Compile Remove="0-Old Version Backup\**" />
    <Compile Remove="0-Old Version Bin\**" />
    <Page Remove="0-Old Version Backup\**" />
    <None Remove="0-Old Version Backup\**" />
    <ApplicationDefinition Remove="0-Old Version Backup\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoDirector.csproj" />
  </ItemGroup>

</Project>
