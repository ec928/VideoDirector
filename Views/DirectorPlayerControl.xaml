<UserControl
    x:Class="VideoDirector.Views.DirectorPlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Grid>
        <!-- Track 0's placement box. Track 0 used to be implicitly full-frame with no box at all,
             which is why it alone could not be moved or resized in the composite. This grid IS its
             box — the engine sets size/position/clip on it from the clip's placement fields, the
             same way it does for every other track. Left/Top aligned so Margin positions it. -->
        <Grid x:Name="BaseBox" x:FieldModifier="public"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid x:Name="GridB" x:FieldModifier="public" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="TransformB" x:FieldModifier="public" />
                </Grid.RenderTransform>
                <!-- Margin="-1" — see the note on OverlayPlayer1 below. -->
                <MediaPlayerElement x:Name="PlayerB" x:FieldModifier="public" AreTransportControlsEnabled="False" Stretch="UniformToFill" Opacity="0" Margin="-1" />
            </Grid>
            <Grid x:Name="GridA" x:FieldModifier="public" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="TransformA" x:FieldModifier="public" />
                </Grid.RenderTransform>
                <MediaPlayerElement x:Name="PlayerA" x:FieldModifier="public" AreTransportControlsEnabled="False" Stretch="UniformToFill" Opacity="1" Margin="-1" />
            </Grid>
        </Grid>

        <!-- Overlay Players (rendered on top of main A/B roll, below WYSIWYG and InputLayer).
             Each overlay grid IS the placement box (the PiP window): its size/position/clip are
             set in code (VideoPlaybackEngine.ApplyOverlayBox) from the clip's placement fields.
             The CompositeTransform lives on the MediaPlayerElement and frames the CONTENT
             (marks: zoom/pan/motion), clipped to the box. During edit the box fills the screen
             so content is framed full-size, identical to Track 1. -->
        <Grid x:Name="OverlayGrid1" x:FieldModifier="public"
              Opacity="0" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <!-- Margin="-1" is the fix for the shimmering border. The picture is drawn one pixel
                 proud of its box on every side, so the clip always cuts through interior texels.
                 A picture that fills its box EXACTLY puts the texture edge on the clip boundary;
                 the GPU then samples past the end of the surface, and because those texels are
                 rewritten every frame the hairline changes every frame — which is why it only
                 ever showed during playback. Equal placement fractions (0.3 x 0.3) make the box
                 aspect match the video aspect exactly, which is what triggered it. Rationale and
                 the evidence are in Models/SurfaceAspect.cs. -->
            <MediaPlayerElement x:Name="OverlayPlayer1" x:FieldModifier="public"
                                AreTransportControlsEnabled="False" Stretch="UniformToFill"
                                Margin="-1"
                                RenderTransformOrigin="0.5,0.5">
                <MediaPlayerElement.RenderTransform>
                    <CompositeTransform x:Name="OverlayTransform1" x:FieldModifier="public" />
                </MediaPlayerElement.RenderTransform>
            </MediaPlayerElement>
            <!-- Still-image proxy for Arrange/scrub (§7A): a plain bitmap reshapes/moves/crops
                 cleanly where the live video surface goes blank/green. Video shows only at playback.
                 UniformToFill is correct ONLY because the box is shaped from the clip's real
                 SourceAspect: the VideosView thumbnail is itself a letterboxed 16:9 image, and
                 filling crops its bars away so the actual content fills the box (and matches how
                 the video crop-fills at playback). -->
            <Image x:Name="OverlayImage1" x:FieldModifier="public" Stretch="UniformToFill" Visibility="Collapsed" />
            <!-- Frame marking an arrangeable PiP. Visual only; reshape grab-zones are geometric
                 (edge/corner bands on the InputLayer), so no drawn handles are needed. -->
            <Grid x:Name="OverlayFrame1" x:FieldModifier="public" IsHitTestVisible="False" Visibility="Collapsed">
                <Border BorderBrush="#99FFFFFF" BorderThickness="1" />
            </Grid>
        </Grid>
        <Grid x:Name="OverlayGrid2" x:FieldModifier="public"
              Opacity="0" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <MediaPlayerElement x:Name="OverlayPlayer2" x:FieldModifier="public"
                                AreTransportControlsEnabled="False" Stretch="UniformToFill"
                                Margin="-1"
                                RenderTransformOrigin="0.5,0.5">
                <MediaPlayerElement.RenderTransform>
                    <CompositeTransform x:Name="OverlayTransform2" x:FieldModifier="public" />
                </MediaPlayerElement.RenderTransform>
            </MediaPlayerElement>
            <Image x:Name="OverlayImage2" x:FieldModifier="public" Stretch="UniformToFill" Visibility="Collapsed" />
            <Grid x:Name="OverlayFrame2" x:FieldModifier="public" IsHitTestVisible="False" Visibility="Collapsed">
                <Border BorderBrush="#99FFFFFF" BorderThickness="1" />
            </Grid>
        </Grid>
        <!-- Third overlay unit (Track 4). Surfaces are pre-declared and bounded at 3; the engine
             addresses them generically via OverlayVisuals[i] — see §7B. -->
        <Grid x:Name="OverlayGrid3" x:FieldModifier="public"
              Opacity="0" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <MediaPlayerElement x:Name="OverlayPlayer3" x:FieldModifier="public"
                                AreTransportControlsEnabled="False" Stretch="UniformToFill"
                                Margin="-1"
                                RenderTransformOrigin="0.5,0.5">
                <MediaPlayerElement.RenderTransform>
                    <CompositeTransform x:Name="OverlayTransform3" x:FieldModifier="public" />
                </MediaPlayerElement.RenderTransform>
            </MediaPlayerElement>
            <Image x:Name="OverlayImage3" x:FieldModifier="public" Stretch="UniformToFill" Visibility="Collapsed" />
            <Grid x:Name="OverlayFrame3" x:FieldModifier="public" IsHitTestVisible="False" Visibility="Collapsed">
                <Border BorderBrush="#99FFFFFF" BorderThickness="1" />
            </Grid>
        </Grid>

        <!-- The framing editor (Edit mode).
             The whole source frame is shown undistorted and the three keyframes are drawn as
             camera rectangles INSIDE it, so all three are visible at once in a stable relationship.
             Everything here is positioned from code (VideoPlaybackEngine.UpdateFramingOverlay);
             the geometry itself is the pure, tested Models/FramingRects. -->
        <Canvas x:Name="FramingCanvas" x:FieldModifier="public" IsHitTestVisible="False"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
            <!-- Everything outside the selected rectangle is dimmed, so the part of the frame that
                 will actually be seen reads at full strength. Four bands rather than a mask, which
                 keeps it to plain rectangles. -->
            <Rectangle x:Name="DimTop" x:FieldModifier="public" Fill="#99000000" />
            <Rectangle x:Name="DimBottom" x:FieldModifier="public" Fill="#99000000" />
            <Rectangle x:Name="DimLeft" x:FieldModifier="public" Fill="#99000000" />
            <Rectangle x:Name="DimRight" x:FieldModifier="public" Fill="#99000000" />

            <!-- The frame's own bounds, so it is obvious where the picture ends. -->
            <Rectangle x:Name="FrameBounds" x:FieldModifier="public" Stroke="#66FFFFFF" StrokeThickness="1" Fill="Transparent" />

            <!-- Motion path: joins the keyframe centres in order, so the move reads at a glance. -->
            <Polyline x:Name="MotionPath" x:FieldModifier="public" Stroke="#CCFFFFFF" StrokeThickness="1.5" StrokeDashArray="3,3" />

            <!-- Where the camera actually is at the playhead. Follows the scrubber. -->
            <Rectangle x:Name="PlayheadRect" x:FieldModifier="public" Stroke="#FFEF4444" StrokeThickness="1" Fill="Transparent" Visibility="Collapsed" />

            <Rectangle x:Name="StartRect" x:FieldModifier="public" Stroke="Cyan" Fill="Transparent" StrokeThickness="2" Visibility="Collapsed" />
            <Rectangle x:Name="MidRect" x:FieldModifier="public" Stroke="DeepSkyBlue" Fill="Transparent" StrokeThickness="2" Visibility="Collapsed" />
            <Rectangle x:Name="EndRect" x:FieldModifier="public" Stroke="RoyalBlue" Fill="Transparent" StrokeThickness="2" Visibility="Collapsed" />

            <!-- Resize handles, shown on the selected rectangle only. -->
            <Canvas x:Name="HandleLayer" x:FieldModifier="public" />

            <!-- Which keyframe is being framed. -->
            <Border x:Name="FramingBadge" x:FieldModifier="public" Background="#CC000000" CornerRadius="4"
                    Padding="8,3" Visibility="Collapsed">
                <TextBlock x:Name="FramingBadgeText" x:FieldModifier="public" FontSize="11" FontWeight="SemiBold" Foreground="White" />
            </Border>
        </Canvas>

        <!-- Interactive Input Layer for Manual Targeting -->
        <Grid x:Name="InputLayer" Background="Transparent"
              PointerWheelChanged="InputLayer_PointerWheelChanged"
              PointerPressed="InputLayer_PointerPressed"
              PointerMoved="InputLayer_PointerMoved"
              PointerReleased="InputLayer_PointerReleased"
              PointerCanceled="InputLayer_PointerCanceled"
              DoubleTapped="InputLayer_DoubleTapped"
              RightTapped="InputLayer_RightTapped" />

        <!-- HUD Overlays -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Spacing="16" IsHitTestVisible="False">
            <!-- Telemetry Overlay -->
            <Grid x:Name="TelemetryOverlay" x:FieldModifier="public" Background="#80000000" CornerRadius="4" Padding="12" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="TELEMETRY" FontWeight="Bold" Foreground="Lime"/>
                    <TextBlock x:Name="TelemetryStoryTime" x:FieldModifier="public" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryClipTime" x:FieldModifier="public" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryVideoSize" x:FieldModifier="public" Foreground="Yellow" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryOperationInfo" x:FieldModifier="public" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryStartMarkInfo" x:FieldModifier="public" Foreground="Cyan" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryMidMarkInfo" x:FieldModifier="public" Foreground="DeepSkyBlue" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryEndMarkInfo" x:FieldModifier="public" Foreground="RoyalBlue" FontFamily="Consolas" />
                </StackPanel>
            </Grid>


        </StackPanel>
              
    </Grid>
</UserControl>
