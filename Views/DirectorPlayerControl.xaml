<UserControl
    x:Class="VideoDirector.Views.DirectorPlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Grid x:Name="RootLayer" Background="Black">
        <!-- Input sits UNDERNEATH everything on purpose. The track surfaces, the borders and the
             canvas edge are all hit-test-invisible, so pointer input falls straight through to
             here; only the WYSIWYG handles above it consume anything. It stays in PANE space
             rather than moving inside the canvas because a click in the void outside the canvas
             has to be catchable too - that is where you click to drop a selection. -->
        <!-- Interactive Input Layer for Manual Targeting -->
        <Grid x:Name="InputLayer" Background="Transparent"
              PointerWheelChanged="InputLayer_PointerWheelChanged"
              PointerPressed="InputLayer_PointerPressed"
              PointerMoved="InputLayer_PointerMoved"
              PointerReleased="InputLayer_PointerReleased"
              PointerCanceled="InputLayer_PointerCanceled"
              DoubleTapped="InputLayer_DoubleTapped"
              RightTapped="InputLayer_RightTapped">
            <FlyoutBase.AttachedFlyout>
                <MenuFlyout x:Name="PipContextMenu">
                                          <MenuFlyoutItem Text="Edit" Click="EditClip_Click" />
                      <MenuFlyoutSeparator />
                      <ToggleMenuFlyoutItem x:Name="PipHideItem" Text="Hide Video" Click="PipHide_Click" />
                      <ToggleMenuFlyoutItem x:Name="PipLockItem" Text="Lock Video" Click="PipLock_Click" />
                    <MenuFlyoutSeparator />
                      <!-- Size as fractions of the frame, which is how every tool that offers
                           presets at all expresses them. Position is left alone deliberately: a
                           resize should not move the clip you have already placed. -->
                      <!-- Acts on every clip on screen at the playhead, not just the one clicked -
                           a layout is an arrangement of the whole frame. -->
                      <MenuFlyoutSubItem Text="Layout (all on screen)">
                          <MenuFlyoutItem Text="Side by side" Click="PipLayout_Click" Tag="side" />
                          <MenuFlyoutItem Text="Stacked" Click="PipLayout_Click" Tag="stack" />
                          <MenuFlyoutItem Text="Grid" Click="PipLayout_Click" Tag="grid" />
                      </MenuFlyoutSubItem>
                      <MenuFlyoutSubItem Text="Size">
                          <!-- ONE basis for the percentages: the window. 100% is the whole frame
                               scaled to the window - full screen - and every other percentage is a
                               fraction of that, so 75% is always three-quarters of 100%.
                               Actual Size is deliberately not a percentage. It is measured against
                               the source's own pixels, so giving it a number would put it on a
                               different scale from the rest and invite comparisons that make no
                               sense - which is exactly what "100% (actual size)" next to "75%"
                               did, since 75% of a window can be larger than 100% of a small
                               source. -->
                          <MenuFlyoutItem Text="100% (full screen)" Click="PipSize_Click" Tag="1.0" />
                          <MenuFlyoutItem Text="75%" Click="PipSize_Click" Tag="0.75" />
                          <MenuFlyoutItem Text="50%" Click="PipSize_Click" Tag="0.5" />
                          <MenuFlyoutItem Text="33%" Click="PipSize_Click" Tag="0.33" />
                          <MenuFlyoutItem Text="25%" Click="PipSize_Click" Tag="0.25" />
                          <MenuFlyoutSeparator />
                          <!-- Neither of these is a percentage of the window, so neither gets a
                               number: Fill Canvas is measured against the CANVAS and crops whatever
                               overhangs, Actual Size against the source's own pixels. -->
                          <MenuFlyoutItem Text="Fill Canvas (crops)" Click="PipSize_Click" Tag="fill" />
                          <MenuFlyoutItem Text="Actual Size" Click="PipSize_Click" Tag="actual" />
                      </MenuFlyoutSubItem>
                      <MenuFlyoutSubItem Text="Opacity">
                          <RadioMenuFlyoutItem x:Name="PipOpacity100" Text="100%" Click="Opacity_Click" Tag="1.0" GroupName="PipOpacity" />
                          <RadioMenuFlyoutItem x:Name="PipOpacity75" Text="75%" Click="Opacity_Click" Tag="0.75" GroupName="PipOpacity" />
                          <RadioMenuFlyoutItem x:Name="PipOpacity50" Text="50%" Click="Opacity_Click" Tag="0.5" GroupName="PipOpacity" />
                          <RadioMenuFlyoutItem x:Name="PipOpacity25" Text="25%" Click="Opacity_Click" Tag="0.25" GroupName="PipOpacity" />
                      </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem Text="Border" x:Name="PipBorderMenu">
                        <RadioMenuFlyoutItem x:Name="PipBorderTypeNone" Text="Type: None" Click="BorderType_Click" Tag="None" GroupName="PipBorderType" />
                        <RadioMenuFlyoutItem x:Name="PipBorderTypeSolid" Text="Type: Solid" Click="BorderType_Click" Tag="Solid" GroupName="PipBorderType" />
                        <RadioMenuFlyoutItem x:Name="PipBorderTypeSoft" Text="Type: Soft" Click="BorderType_Click" Tag="Soft" GroupName="PipBorderType" />
                        <RadioMenuFlyoutItem x:Name="PipBorderTypeFilmStrip" Text="Type: FilmStrip" Click="BorderType_Click" Tag="FilmStrip" GroupName="PipBorderType" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem x:Name="PipBorderColorWhite" Text="Color: White" Click="BorderColor_Click" Tag="White" GroupName="PipBorderColor" />
                        <RadioMenuFlyoutItem x:Name="PipBorderColorBlack" Text="Color: Black" Click="BorderColor_Click" Tag="Black" GroupName="PipBorderColor" />
                        <RadioMenuFlyoutItem x:Name="PipBorderColorRed" Text="Color: Red" Click="BorderColor_Click" Tag="Red" GroupName="PipBorderColor" />
                        <RadioMenuFlyoutItem x:Name="PipBorderColorGold" Text="Color: Gold" Click="BorderColor_Click" Tag="Gold" GroupName="PipBorderColor" />
                        <RadioMenuFlyoutItem x:Name="PipBorderColorBlue" Text="Color: Blue" Click="BorderColor_Click" Tag="Blue" GroupName="PipBorderColor" />
                        <RadioMenuFlyoutItem x:Name="PipBorderColorGreen" Text="Color: Green" Click="BorderColor_Click" Tag="Green" GroupName="PipBorderColor" />
                        <RadioMenuFlyoutItem x:Name="PipBorderColorDarkGrey" Text="Color: Dark Grey" Click="BorderColor_Click" Tag="DarkGrey" GroupName="PipBorderColor" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem x:Name="PipBorderThick2" Text="Thickness: Thin (2)" Click="BorderThickness_Click" Tag="2" GroupName="PipBorderThickness" />
                        <RadioMenuFlyoutItem x:Name="PipBorderThick4" Text="Thickness: Normal (4)" Click="BorderThickness_Click" Tag="4" GroupName="PipBorderThickness" />
                        <RadioMenuFlyoutItem x:Name="PipBorderThick8" Text="Thickness: Thick (8)" Click="BorderThickness_Click" Tag="8" GroupName="PipBorderThickness" />
                    </MenuFlyoutSubItem>
                </MenuFlyout>
            </FlyoutBase.AttachedFlyout>
        </Grid>

        <!-- THE CANVAS.

             A composition space of its own fixed size, rather than "whatever the pane happens to
             be right now". Everything is measured against it, so hiding the dock, resizing the
             window or going fullscreen changes only the SCALE at which the arrangement is seen -
             never the arrangement itself. Before this, the pane WAS the composition, so the dock
             stole height from the frame and playback silently handed it back.

             CanvasTransform scales it to fit the pane and carries the Arrange-mode zoom and pan
             on top. Centred, so scaling about the middle keeps it put. -->
        <Grid x:Name="CanvasHost" x:FieldModifier="public"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="1920" Height="1080" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="CanvasTransform" x:FieldModifier="public" />
            </Grid.RenderTransform>

            <!-- Track render surfaces are built in code and INSERTED HERE at 0..MaxTracks-1, so
                 they land beneath everything declared below and stack in track order among
                 themselves. Built rather than declared so the slot count and the visual count
                 cannot drift apart. -->

            <!-- Clip borders, above every track picture. They cannot be drawn inside the clip they
                 belong to: a XAML shape beneath a video surface is erased rather than blended, so
                 a clip at 35% opacity on a higher track wiped a lower border out completely. -->
            <Canvas x:Name="BorderHost" x:FieldModifier="public" IsHitTestVisible="False" />

            <!-- Where the frame ends.

                 A 1px near-transparent hairline was effectively invisible against video. This is a
                 translucent cool white-blue at 2px, deliberately a colour no track uses so it never
                 reads as a clip outline, plus a badge in the same idiom as the T1..T6 track badges
                 so the two are obviously the same kind of label.

                 The badge sits INSIDE the canvas, top centre. Track badges are all top-LEFT, so the
                 centre is never mistaken for one, and inside means it cannot be clipped away when
                 the canvas reaches the edge of the pane - which is what happened when it hung in
                 the void above the canvas. -->
            <Grid x:Name="CanvasEdge" x:FieldModifier="public" IsHitTestVisible="False">
                <Rectangle x:Name="CanvasEdgeStroke" Fill="Transparent" Stroke="#7C838D" StrokeThickness="1" />
                <Border x:Name="CanvasBadge" Background="#E6353A42" CornerRadius="3" Padding="8,2" MinWidth="96"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="4">
                    <TextBlock x:Name="CanvasLabel" Text="Canvas" FontSize="10" FontWeight="SemiBold"
                               Foreground="#C9CED6" HorizontalAlignment="Center" />
                </Border>
            </Grid>

            <!-- WYSIWYG Overlay for Edit Mode (Interactive Grids) -->
            <Canvas x:Name="WysiwygCanvas" x:FieldModifier="public" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- The three keyframe rectangles live INSIDE the canvas so their geometry matches
                     the clips, which are measured against it. That means they are scaled by the
                     canvas transform - and 10px bold text rasterised at a fractional scale turns to
                     mush, which is what happened to these labels at any canvas scale other than 1
                     (cinematic is 1.06, and any window resize does it).

                     Each tab therefore carries the INVERSE scale, applied in UpdateCanvasLayout, so
                     the rectangles scale with the picture while their labels stay legible at their
                     designed size. RenderTransformOrigin anchors each tab to the corner it hangs
                     off, so counter-scaling does not detach it from its rectangle. -->
                <!-- Start Box -->
                <Grid x:Name="WysiwygStartRect" x:FieldModifier="public" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="WysiwygStartPop" x:FieldModifier="public" />
                    </Grid.RenderTransform>
                    <Rectangle x:Name="WysiwygStartFrame" x:FieldModifier="public" Stroke="Cyan" Fill="Transparent" StrokeThickness="2" StrokeDashArray="4,4" IsHitTestVisible="False" />
                    <Border x:Name="WysiwygStartTab" RenderTransformOrigin="0,1" Background="Cyan" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-22,0,0" CornerRadius="4,4,0,0" 
                            PointerPressed="WysiwygTab_PointerPressed" PointerMoved="WysiwygTab_PointerMoved" PointerReleased="WysiwygTab_PointerReleased" PointerCanceled="WysiwygTab_PointerReleased" Tag="Start">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="WysiwygStartTabScale" />
                        </Border.RenderTransform>
                         <TextBlock Text="Start Frame" FontSize="10" Foreground="Black" FontWeight="Bold"/>
                    </Border>
                    <Rectangle Width="12" Height="12" Fill="Cyan" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="Start,TL"/>
                    <Rectangle Width="12" Height="12" Fill="Cyan" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="Start,TR"/>
                    <Rectangle Width="12" Height="12" Fill="Cyan" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="Start,BL"/>
                    <Rectangle Width="12" Height="12" Fill="Cyan" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="Start,BR"/>
                </Grid>

                <!-- Mid Box -->
                <Grid x:Name="WysiwygMidRect" x:FieldModifier="public" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="WysiwygMidPop" x:FieldModifier="public" />
                    </Grid.RenderTransform>
                    <Rectangle x:Name="WysiwygMidFrame" x:FieldModifier="public" Stroke="DeepSkyBlue" Fill="Transparent" StrokeThickness="2" StrokeDashArray="4,4" IsHitTestVisible="False" />
                    <Border x:Name="WysiwygMidTab" RenderTransformOrigin="0.5,1" Background="DeepSkyBlue" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-22,0,0" CornerRadius="4,4,0,0" 
                            PointerPressed="WysiwygTab_PointerPressed" PointerMoved="WysiwygTab_PointerMoved" PointerReleased="WysiwygTab_PointerReleased" PointerCanceled="WysiwygTab_PointerReleased" Tag="Mid">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="WysiwygMidTabScale" />
                        </Border.RenderTransform>
                         <TextBlock Text="Mid Frame" FontSize="10" Foreground="Black" FontWeight="Bold"/>
                    </Border>
                    <Rectangle Width="12" Height="12" Fill="DeepSkyBlue" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="Mid,TL"/>
                    <Rectangle Width="12" Height="12" Fill="DeepSkyBlue" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="Mid,TR"/>
                    <Rectangle Width="12" Height="12" Fill="DeepSkyBlue" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="Mid,BL"/>
                    <Rectangle Width="12" Height="12" Fill="DeepSkyBlue" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="Mid,BR"/>
                </Grid>

                <!-- End Box -->
                <Grid x:Name="WysiwygEndRect" x:FieldModifier="public" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="WysiwygEndPop" x:FieldModifier="public" />
                    </Grid.RenderTransform>
                    <Rectangle x:Name="WysiwygEndFrame" x:FieldModifier="public" Stroke="RoyalBlue" Fill="Transparent" StrokeThickness="2" StrokeDashArray="4,4" IsHitTestVisible="False" />
                    <Border x:Name="WysiwygEndTab" RenderTransformOrigin="1,1" Background="RoyalBlue" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-22,0,0" CornerRadius="4,4,0,0" 
                            PointerPressed="WysiwygTab_PointerPressed" PointerMoved="WysiwygTab_PointerMoved" PointerReleased="WysiwygTab_PointerReleased" PointerCanceled="WysiwygTab_PointerReleased" Tag="End">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="WysiwygEndTabScale" />
                        </Border.RenderTransform>
                         <TextBlock Text="End Frame" FontSize="10" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <Rectangle Width="12" Height="12" Fill="RoyalBlue" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="End,TL"/>
                    <Rectangle Width="12" Height="12" Fill="RoyalBlue" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="End,TR"/>
                    <Rectangle Width="12" Height="12" Fill="RoyalBlue" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-6,0,0,-6"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="End,BL"/>
                    <Rectangle Width="12" Height="12" Fill="RoyalBlue" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"  PointerPressed="WysiwygHandle_PointerPressed" PointerMoved="WysiwygHandle_PointerMoved" PointerReleased="WysiwygHandle_PointerReleased" PointerCanceled="WysiwygHandle_PointerReleased" Tag="End,BR"/>
                </Grid>
            </Canvas>
        </Grid>

        <!-- HUD Overlays -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Spacing="16" IsHitTestVisible="False">
            <!-- Telemetry Overlay -->
            <Grid x:Name="TelemetryOverlay" x:FieldModifier="public" Background="#80000000" CornerRadius="4" Padding="12" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="TELEMETRY" FontWeight="Bold" Foreground="Lime"/>
                    <TextBlock x:Name="TelemetryStoryTime" x:FieldModifier="public" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryClipTime" x:FieldModifier="public" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryVideoSize" x:FieldModifier="public" Foreground="Yellow" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryOperationInfo" x:FieldModifier="public" Foreground="White" FontFamily="Consolas" />
                    <!-- Geometry HUD: box on screen, motion transform, and the region of the SOURCE
                         frame it samples. Written by WriteGeometryTelemetry, throttled to ~10Hz. -->
                    <TextBlock x:Name="TelemetryGeometry" x:FieldModifier="public" Foreground="Orange" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryStartMarkInfo" x:FieldModifier="public" Foreground="Cyan" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryMidMarkInfo" x:FieldModifier="public" Foreground="DeepSkyBlue" FontFamily="Consolas" />
                    <TextBlock x:Name="TelemetryEndMarkInfo" x:FieldModifier="public" Foreground="RoyalBlue" FontFamily="Consolas" />
                </StackPanel>
            </Grid>


        </StackPanel>
              
    </Grid>
</UserControl>



