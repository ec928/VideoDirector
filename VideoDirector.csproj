<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>  
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>VideoDirector</RootNamespace>

    <!-- Drives the version shown in About, and the one publish.bat stamps into the release.
         Read from the assembly at runtime rather than duplicated in the UI, so the number in
         the dialog is always the number that shipped. Bump before cutting a release tag. -->
    <Version>0.9.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      'annotations' rather than 'enable': nullable syntax (T?) is honoured, but the
      compiler does not emit nullable diagnostics. This codebase predates nullable
      reference types. Annotating the fields honestly cascades into ~60 dereference
      warnings through VideoPlaybackEngine's playback/seek/transition paths, which is
      a refactor rather than a cleanup. Revisit by switching to 'enable' and working
      through the diagnostics file by file.
    -->
    <Nullable>annotations</Nullable>

    <!--
      Output layout. Two builds, two folders, nothing anywhere else:

          bin\Debug\VideoDirector.exe      dotnet build          - the test build
          bin\Release\VideoDirector.exe    publish.bat           - the shippable build

      Release IS the publish output. `dotnet publish` has to build before it copies, and
      that build lands in bin\Release regardless; pointing PublishDir anywhere else
      just leaves a half-built Release folder beside the real one. So they are the same
      folder, and a Release build is by definition the self-contained portable one.

      The two Append switches drop the "net8.0-windows10.0.19041.0\win-x64" tail the SDK
      adds by default. There is exactly one TFM and one RID here, so that tail carries no
      information and only buries the exe four levels down.
    -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Pinned here so EVERY publish lands in the Release folder, however it is invoked.
         Without it a bare `dotnet publish` uses the SDK default and buries the output in
         bin\Release\win-x64\publish\ — a nested copy of the folder it just built.

         No $(Platform) segment: the two Append* settings above already strip the TFM
         and RID subfolders, so `dotnet build` lands in bin\Debug and bin\Release.
         Including Platform here sent publish to bin\x64\Release instead — a fourth
         folder nothing else in the project ever looked at. -->
    <PublishDir>bin\$(Configuration)\</PublishDir>

    <!-- Pinned for the same reason, from the other direction. The SDK default is
         bin\$(Configuration)\ ONLY while Platform is AnyCPU; the moment a platform is named
         it becomes bin\$(Platform)\$(Configuration)\. The .slnx maps every solution platform
         to x64, so building from the IDE quietly grew a second 170MB bind\Debug tree
         beside the real one - the exact "test a stale binary" hazard this layout exists to
         prevent. obj is left to split by platform: it is disposable, and keeping the
         intermediates apart is the honest thing for a project that lists three platforms. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
  
    <!--
      Ship English resources only. Note this handles .NET satellite assemblies but NOT
      WinUI's .mui files - those are Win32 MUI resources and need the target below.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Views\DirectorPlayerControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Views\DirectorTemplates.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Views\TimelineRangeSlider.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Views\VideoDirectorControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
    <!--
      Never single-file, in any configuration. Single-file self-extracts the entire runtime
      to %TEMP% on the first launch after every publish, which measurably slows cold start.
      This was True for non-Debug while publish.bat and FolderProfile.pubxml both passed
      False, so the setting was inert but contradicted them (and the README) — a trap for
      anyone publishing without one of those.
    -->
    <PublishSingleFile>False</PublishSingleFile>
    <ApplicationIcon>VideoDirector.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    WinUI emits ~86 locale folders of .mui resources into the output. About 3.6 MB, but
    the real cost is 86 directories to scroll past every time you open the folder looking
    for the exe. English is kept; the rest go.

    Consequence: WinUI's own system strings (dialog buttons and similar) appear in English
    on a non-English Windows. This app has no localised resources of its own, so nothing
    else changes. Delete this target to restore every language.
  -->
  <Target Name="TrimLocaleResourceFolders" AfterTargets="Build;Publish">
    <ItemGroup>
      <_AllMui Include="$(OutDir)*\*.mui" />
      <_KeepMui Include="$(OutDir)en*\*.mui" />
      <_DropMui Include="@(_AllMui)" Exclude="@(_KeepMui)" />
    </ItemGroup>
    <Delete Files="@(_DropMui)" ContinueOnError="true" />
    <RemoveDir Directories="@(_DropMui->'%(RootDir)%(Directory)'->Distinct())" ContinueOnError="true" />
  </Target>


  <!--
    WindowsAppSDK self-contained deployment ships Windows ML (onnxruntime + DirectML,
    ~38 MB). Its own targets only suppress these for Framework/Passthrough modes, not
    SelfContained. This app never touches the ML APIs, so delete them from the output.
    Deleted from $(OutDir) rather than filtered from the publish list: PublishDir is the
    build output folder, so the build has already copied them by the time publish runs.
    If ML APIs are ever used, delete this target.
  -->
  <Target Name="RemoveUnusedWindowsML" AfterTargets="Build;Publish">
    <ItemGroup>
      <_UnusedMl Include="$(OutDir)onnxruntime.dll" />
      <_UnusedMl Include="$(OutDir)DirectML.dll" />
    </ItemGroup>
    <Delete Files="@(_UnusedMl)" ContinueOnError="true" />
  </Target>

  <!-- The test project is built separately (VideoDirector.Tests\VideoDirector.Tests.csproj).
       Without this the app's **/*.cs glob compiles the tests into the app and fails on xunit.
       Tests\ holds gitignored working projects and no sources, but is excluded for the same
       reason should any ever land there. -->
  <ItemGroup>
    <Compile Remove="VideoDirector.Tests\**" />
    <None Remove="VideoDirector.Tests\**" />
    <Page Remove="VideoDirector.Tests\**" />
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
  </ItemGroup>

</Project>
