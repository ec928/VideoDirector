<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>  
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>VideoDirector</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      'annotations' rather than 'enable': nullable syntax (T?) is honoured, but the
      compiler does not emit nullable diagnostics. This codebase predates nullable
      reference types. Annotating the fields honestly cascades into ~60 dereference
      warnings through VideoPlaybackEngine's playback/seek/transition paths, which is
      a refactor rather than a cleanup. Revisit by switching to 'enable' and working
      through the diagnostics file by file.
    -->
    <Nullable>annotations</Nullable>

    <!--
      Output layout. Two builds, two folders, nothing anywhere else:

          bin\x64\Debug\VideoDirector.exe      dotnet build          - the test build
          bin\x64\Release\VideoDirector.exe    publish.bat           - the shippable build

      Release IS the publish output. `dotnet publish` has to build before it copies, and
      that build lands in bin\x64\Release regardless; pointing PublishDir anywhere else
      just leaves a half-built Release folder beside the real one. So they are the same
      folder, and a Release build is by definition the self-contained portable one.

      The two Append switches drop the "net8.0-windows10.0.19041.0\win-x64" tail the SDK
      adds by default. There is exactly one TFM and one RID here, so that tail carries no
      information and only buries the exe four levels down.
    -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Pinned here so EVERY publish lands in the Release folder, however it is invoked.
         Without it a bare `dotnet publish` uses the SDK default and buries the output in
         bin\x64\Release\win-x64\publish\ — a nested copy of the folder it just built. -->
    <PublishDir>bin\$(Platform)\$(Configuration)\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Views\DirectorPlayerControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Views\DirectorTemplates.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Views\TimelineRangeSlider.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Views\VideoDirectorControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
    <!--
      Never single-file, in any configuration. Single-file self-extracts the entire runtime
      to %TEMP% on the first launch after every publish, which measurably slows cold start.
      This was True for non-Debug while publish.bat and FolderProfile.pubxml both passed
      False, so the setting was inert but contradicted them (and the README) — a trap for
      anyone publishing without one of those.
    -->
    <PublishSingleFile>False</PublishSingleFile>
    <ApplicationIcon>VideoDirector.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
